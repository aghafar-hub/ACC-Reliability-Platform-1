# Copy to .env for local development. In production (Cloud Run), these are
# set as real environment variables / secrets instead of a file — never
# commit a real .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=acc_reliability

# HMAC secret used to sign session tokens (JWT). Generate a long random
# string for real deployments — never reuse this placeholder.
JWT_SECRET=dev-only-change-me

PORT=3001
