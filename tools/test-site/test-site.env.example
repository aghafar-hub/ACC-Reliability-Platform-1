# Copy this file to test-site.env (same folder) and paste in the /exec URLs
# of your three TEST COPY web app deployments — never the live ones (the
# script refuses the live Oil and Vibration URLs). test-site.env is ignored
# by git. See docs/test-copy-setup.md.

VITE_PLATFORM_CORE_URL=https://script.google.com/macros/s/PASTE_TEST_PLATFORM_CORE_ID/exec
VITE_OIL_ANALYSIS_URL=https://script.google.com/macros/s/PASTE_TEST_OIL_ID/exec
VITE_VIBRATION_ANALYSIS_URL=https://script.google.com/macros/s/PASTE_TEST_VIBRATION_ID/exec
